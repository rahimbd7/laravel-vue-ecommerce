# Copy this file to `.env` (next to docker-compose.yml) to override the Docker
# defaults. `docker compose` reads that file automatically for the ${VAR:-default}
# substitutions used in docker-compose.yml.

# --- MySQL -------------------------------------------------------------------
MYSQL_DATABASE=ecommerce
DB_USERNAME=laravel
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret
# Change if port 3306 is already used on your machine (e.g. XAMPP/Laragon MySQL)
MYSQL_PORT=3306

# --- Ports / images ----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
PHPMYADMIN_PORT=8080

# --- Laravel -----------------------------------------------------------------
APP_NAME="Laravel Vue Ecommerce"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Pin the app key so sessions/tokens survive container rebuilds:
#   docker compose exec backend php artisan key:generate --show
# APP_KEY=base64:xxxxxxxxxxxxxxxxxxxx

# --- Frontend build-time vars (inlined into the bundle at image build) -------
VITE_API_URL=http://localhost:8000/api
VITE_CLOUDINARY_CLOUD_NAME=dqhf9ljat
VITE_CLOUDINARY_PRODUCT_PRESET=product_preset
VITE_CLOUDINARY_CATEGORY_PRESET=category_preset
VITE_CLOUDINARY_PROFILE_PRESET=profile_preset
